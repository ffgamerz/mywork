SUPABASE_SERVICE_KEY=YOUR_SERVER_SERVICE_ROLE_KEY
BOT_API_KEY=YOUR_RANDOM_KEY_AT_LEAST_32_CHARACTERS
BOT_USER_ID=UUID_OF_EXISTING_SUPER_ADMIN
